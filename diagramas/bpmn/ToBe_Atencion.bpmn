<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe_Atencion" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:dataStore id="DataStore_Agenda" name="Agenda centralizada" />
  <bpmn:dataStore id="DataStore_Pacientes" name="Registro de pacientes" />
  <bpmn:dataStore id="DataStore_HC" name="Historia clínica digital" />
  <bpmn:dataStore id="DataStore_Cobros" name="Registro de cobros" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Ciclo completo de atención con el sistema" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Paciente" name="Paciente">
        <bpmn:flowNodeRef>Start_Llega</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretaria" name="Secretaria">
        <bpmn:flowNodeRef>Task_CheckIn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Nuevo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Filiacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Conv1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cobrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Cita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Agendar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Conv3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Atencion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Odonto" name="Odontólogo/a">
        <bpmn:flowNodeRef>Task_Abrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tratar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Receta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Conv2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cerrar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Llega" name="Paciente llega al consultorio" />
    <bpmn:userTask id="Task_CheckIn" name="Buscar al paciente y registrar su llegada en la agenda">
      <bpmn:dataOutputAssociation id="DOA_CheckIn"><bpmn:targetRef>DSRef_Agenda1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Nuevo" name="¿Paciente nuevo?" />
    <bpmn:userTask id="Task_Filiacion" name="Registrar datos de filiación">
      <bpmn:dataOutputAssociation id="DOA_Filiacion"><bpmn:targetRef>DSRef_Pacientes</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Conv1" />
    <bpmn:userTask id="Task_Abrir" name="Abrir la atención y revisar el historial del paciente">
      <bpmn:property id="Property_Abrir" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Abrir"><bpmn:sourceRef>DSRef_HC1</bpmn:sourceRef><bpmn:targetRef>Property_Abrir</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Registrar" name="Registrar anamnesis, antecedentes y odontograma">
      <bpmn:dataOutputAssociation id="DOA_Registrar"><bpmn:targetRef>DSRef_HC1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Tratar" name="Ejecutar tratamiento y registrar diagnóstico CIE-10 y procedimientos">
      <bpmn:dataOutputAssociation id="DOA_Tratar"><bpmn:targetRef>DSRef_HC2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Receta" name="¿Requiere receta?" />
    <bpmn:userTask id="Task_Receta" name="Generar receta desde el catálogo e imprimirla">
      <bpmn:dataOutputAssociation id="DOA_Receta"><bpmn:targetRef>DORef_Receta</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Conv2" />
    <bpmn:userTask id="Task_Cerrar" name="Cerrar la atención">
      <bpmn:dataOutputAssociation id="DOA_Cerrar"><bpmn:targetRef>DSRef_HC3</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Cobrar" name="Cobrar y registrar el abono">
      <bpmn:dataOutputAssociation id="DOA_Cobrar"><bpmn:targetRef>DSRef_Cobros</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Cita" name="¿Requiere próxima cita?" />
    <bpmn:userTask id="Task_Agendar" name="Agendar la siguiente cita en la agenda centralizada">
      <bpmn:dataOutputAssociation id="DOA_Agendar"><bpmn:targetRef>DSRef_Agenda2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Conv3" />
    <bpmn:endEvent id="End_Atencion" name="Atención cerrada y registrada" />

    <bpmn:dataStoreReference id="DSRef_Agenda1" name="Agenda centralizada" dataStoreRef="DataStore_Agenda" />
    <bpmn:dataStoreReference id="DSRef_Pacientes" name="Registro de pacientes" dataStoreRef="DataStore_Pacientes" />
    <bpmn:dataStoreReference id="DSRef_HC1" name="Historia clínica digital" dataStoreRef="DataStore_HC" />
    <bpmn:dataStoreReference id="DSRef_HC2" name="Historia clínica digital" dataStoreRef="DataStore_HC" />
    <bpmn:dataStoreReference id="DSRef_HC3" name="Historia clínica digital" dataStoreRef="DataStore_HC" />
    <bpmn:dataStoreReference id="DSRef_Cobros" name="Registro de cobros" dataStoreRef="DataStore_Cobros" />
    <bpmn:dataStoreReference id="DSRef_Agenda2" name="Agenda centralizada" dataStoreRef="DataStore_Agenda" />
    <bpmn:dataObject id="DataObject_Receta" />
    <bpmn:dataObjectReference id="DORef_Receta" name="Receta (PDF)" dataObjectRef="DataObject_Receta" />

    <bpmn:sequenceFlow id="F1" sourceRef="Start_Llega" targetRef="Task_CheckIn" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CheckIn" targetRef="GW_Nuevo" />
    <bpmn:sequenceFlow id="F3" name="Sí" sourceRef="GW_Nuevo" targetRef="Task_Filiacion" />
    <bpmn:sequenceFlow id="F4" name="No" sourceRef="GW_Nuevo" targetRef="GW_Conv1" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Filiacion" targetRef="GW_Conv1" />
    <bpmn:sequenceFlow id="F6" sourceRef="GW_Conv1" targetRef="Task_Abrir" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Abrir" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Registrar" targetRef="Task_Tratar" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Tratar" targetRef="GW_Receta" />
    <bpmn:sequenceFlow id="F10" name="Sí" sourceRef="GW_Receta" targetRef="Task_Receta" />
    <bpmn:sequenceFlow id="F11" name="No" sourceRef="GW_Receta" targetRef="GW_Conv2" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Receta" targetRef="GW_Conv2" />
    <bpmn:sequenceFlow id="F13" sourceRef="GW_Conv2" targetRef="Task_Cerrar" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Cerrar" targetRef="Task_Cobrar" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Cobrar" targetRef="GW_Cita" />
    <bpmn:sequenceFlow id="F16" name="Sí" sourceRef="GW_Cita" targetRef="Task_Agendar" />
    <bpmn:sequenceFlow id="F17" name="No" sourceRef="GW_Cita" targetRef="GW_Conv3" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Agendar" targetRef="GW_Conv3" />
    <bpmn:sequenceFlow id="F19" sourceRef="GW_Conv3" targetRef="End_Atencion" />

    <bpmn:textAnnotation id="TA_WalkIn"><bpmn:text>Sin cita previa: se crea una cita en un horario libre</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_WalkIn" sourceRef="Task_CheckIn" targetRef="TA_WalkIn" />
    <bpmn:textAnnotation id="TA_Filiacion"><bpmn:text>Los antecedentes ya no se toman en recepción (PC5)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Filiacion" sourceRef="Task_Filiacion" targetRef="TA_Filiacion" />
    <bpmn:textAnnotation id="TA_Odonto"><bpmn:text>Odontograma por pieza y cara: rojo = pendiente, azul = realizado (RF02)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Odonto" sourceRef="Task_Registrar" targetRef="TA_Odonto" />
    <bpmn:textAnnotation id="TA_Cerrar"><bpmn:text>Reemplaza el aviso verbal a recepción: tratamientos y valores quedan disponibles para el cobro</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Cerrar" sourceRef="Task_Cerrar" targetRef="TA_Cerrar" />
    <bpmn:textAnnotation id="TA_Cobrar"><bpmn:text>Recepción ve tratamientos y valores, sin diagnósticos (BN3); saldo calculado</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Cobrar" sourceRef="Task_Cobrar" targetRef="TA_Cobrar" />
    <bpmn:textAnnotation id="TA_Agendar"><bpmn:text>El sistema replica la cita en Google Calendar y programa el recordatorio</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Agendar" sourceRef="Task_Agendar" targetRef="TA_Agendar" />
    <bpmn:textAnnotation id="TA_Fin"><bpmn:text>Sin Etapa 2: la historia clínica digital, con los campos del Formulario 033, queda registrada al cerrar la atención (T4 y T5)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Fin" sourceRef="End_Atencion" targetRef="TA_Fin" />
  </bpmn:process>

