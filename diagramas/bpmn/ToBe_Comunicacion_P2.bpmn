        <di:waypoint x="1280" y="180" /><di:waypoint x="1310" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A_PC8_di" bpmnElement="A_PC8">
        <di:waypoint x="1310" y="660" /><di:waypoint x="1215" y="615" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>