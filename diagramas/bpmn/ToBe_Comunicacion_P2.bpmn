<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe_Comunicacion" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:category id="Category_3">
    <bpmn:categoryValue id="CatVal_3" value="3. Confirmación de citas" />
  </bpmn:category>
  <bpmn:category id="Category_4">
    <bpmn:categoryValue id="CatVal_4" value="4. Derivación: consulta clínica, de saldo o no reconocida" />
  </bpmn:category>
  <bpmn:dataStore id="DataStore_Agenda" name="Agenda centralizada" />
  <bpmn:dataStore id="DataStore_Consent" name="Consentimientos" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Comunicación con el paciente con el agente conversacional — Parte 2: confirmación de citas y derivación" processRef="Process_1" />
    <bpmn:group id="Group_3" categoryValueRef="CatVal_3" />
    <bpmn:group id="Group_4" categoryValueRef="CatVal_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Agente" name="Agente conversacional">
        <bpmn:flowNodeRef>Start_Timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Resp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Confirmada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cancelar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Liberada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SinConf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reprog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reprog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Link_Catch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Derivar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretaria" name="Secretaria">
        <bpmn:flowNodeRef>Task_Atender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resolver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Res1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Odonto" name="Odontólogo/a">
        <bpmn:flowNodeRef>Task_RespClin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Res2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    
    <bpmn:startEvent id="Start_Timer" name="Día previo a la cita, 09:00">
      <bpmn:timerEventDefinition id="TED_1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Record" name="Enviar recordatorio con opciones Confirmar, Cancelar o Reprogramar" />
    <bpmn:exclusiveGateway id="GW_Resp" name="¿Respuesta del paciente?" />
    <bpmn:serviceTask id="Task_Confirmar" name="Registrar la confirmación">
      <bpmn:dataOutputAssociation id="DOA_Confirmar"><bpmn:targetRef>DSRef_AgendaRec</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Confirmada" name="Cita confirmada" />
    <bpmn:serviceTask id="Task_Cancelar" name="Cancelar la cita y liberar el horario">
      <bpmn:dataOutputAssociation id="DOA_Cancelar"><bpmn:targetRef>DSRef_AgendaRec</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Liberada" name="Horario liberado" />
    <bpmn:endEvent id="End_SinConf" name="Cita sin confirmar" />
    <bpmn:serviceTask id="Task_Reprog" name="Ofrecer horarios y reprogramar la cita">
      <bpmn:dataOutputAssociation id="DOA_Reprog"><bpmn:targetRef>DSRef_AgendaRec</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Reprog" name="Cita reprogramada" />

    
    <bpmn:startEvent id="Link_Catch" name="Consulta derivada por el agente (desde la parte 1)">
      <bpmn:messageEventDefinition id="MED_Catch" /></bpmn:startEvent>
    <bpmn:serviceTask id="Task_Derivar" name="Enviar el enlace de WhatsApp de recepción" />
    <bpmn:userTask id="Task_Atender" name="Atender la consulta derivada" />
    <bpmn:exclusiveGateway id="GW_Tipo" name="¿Tipo de consulta?" />
    <bpmn:userTask id="Task_Resolver" name="Resolver saldo, pago u otro asunto administrativo" />
    <bpmn:endEvent id="End_Res1" name="Consulta resuelta" />
    <bpmn:userTask id="Task_RespClin" name="Responder la consulta clínica" />
    <bpmn:endEvent id="End_Res2" name="Consulta resuelta" />

    <bpmn:dataStoreReference id="DSRef_AgendaRec" name="Agenda centralizada" dataStoreRef="DataStore_Agenda" />

    <bpmn:sequenceFlow id="F23" sourceRef="Start_Timer" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="F24" sourceRef="Task_Record" targetRef="GW_Resp" />
    <bpmn:sequenceFlow id="F25" name="Confirma" sourceRef="GW_Resp" targetRef="Task_Confirmar" />
    <bpmn:sequenceFlow id="F26" sourceRef="Task_Confirmar" targetRef="End_Confirmada" />
    <bpmn:sequenceFlow id="F27" name="Cancela" sourceRef="GW_Resp" targetRef="Task_Cancelar" />
    <bpmn:sequenceFlow id="F28" sourceRef="Task_Cancelar" targetRef="End_Liberada" />
    <bpmn:sequenceFlow id="F29" name="No responde" sourceRef="GW_Resp" targetRef="End_SinConf" />
    <bpmn:sequenceFlow id="F37" name="Reprograma" sourceRef="GW_Resp" targetRef="Task_Reprog" />
    <bpmn:sequenceFlow id="F38" sourceRef="Task_Reprog" targetRef="End_Reprog" />
    <bpmn:sequenceFlow id="F30" sourceRef="Link_Catch" targetRef="Task_Derivar" />
    <bpmn:sequenceFlow id="F31" sourceRef="Task_Derivar" targetRef="Task_Atender" />
    <bpmn:sequenceFlow id="F32" sourceRef="Task_Atender" targetRef="GW_Tipo" />
    <bpmn:sequenceFlow id="F33" name="Administrativa" sourceRef="GW_Tipo" targetRef="Task_Resolver" />
    <bpmn:sequenceFlow id="F34" sourceRef="Task_Resolver" targetRef="End_Res1" />
    <bpmn:sequenceFlow id="F35" name="Clínica" sourceRef="GW_Tipo" targetRef="Task_RespClin" />
    <bpmn:sequenceFlow id="F36" sourceRef="Task_RespClin" targetRef="End_Res2" />

    <bpmn:textAnnotation id="TA_Record"><bpmn:text>N3: reemplaza la confirmación manual de 31-60 min/día (RF14); solo a teléfonos con aviso aceptado (RF09)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Record" sourceRef="Task_Record" targetRef="TA_Record" />
    <bpmn:textAnnotation id="TA_Reprog"><bpmn:text>Hasta 2 h antes de la cita; después se deriva a recepción (RF12)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Reprog" sourceRef="Task_Reprog" targetRef="TA_Reprog" />
    <bpmn:textAnnotation id="TA_SinConf"><bpmn:text>La cita queda pendiente y visible para recepción</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_SinConf" sourceRef="End_SinConf" targetRef="TA_SinConf" />
    <bpmn:textAnnotation id="TA_Derivar"><bpmn:text>N5: lo clínico, los saldos y los pacientes no registrados se derivan (RF13, BN7)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Derivar" sourceRef="Task_Derivar" targetRef="TA_Derivar" />
    <bpmn:textAnnotation id="TA_PC8"><bpmn:text>PC8: la secretaria atiende solo lo derivado</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_PC8" sourceRef="Task_Atender" targetRef="TA_PC8" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1790" height="860" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agente_di" bpmnElement="Lane_Agente" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1760" height="480" />
