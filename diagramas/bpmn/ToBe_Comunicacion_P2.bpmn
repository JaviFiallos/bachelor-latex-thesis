        <di:waypoint x="670" y="320" /><di:waypoint x="870" y="278" />
      </bpmndi:BPMNEdge>

      
      <bpmndi:BPMNEdge id="A_Record_di" bpmnElement="A_Record">
        <di:waypoint x="370" y="240" /><di:waypoint x="370" y="270" />
      </bpmndi:BPMNEdge>
