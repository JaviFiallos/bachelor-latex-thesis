      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Res1_di" bpmnElement="End_Res1">
        <dc:Bounds x="1730" y="662" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1710" y="705" width="80" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
