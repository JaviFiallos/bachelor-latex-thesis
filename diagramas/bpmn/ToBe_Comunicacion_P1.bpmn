<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe_Comunicacion" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:category id="Category_1">
    <bpmn:categoryValue id="CatVal_1" value="1. Acceso al agente y consulta general" />
  </bpmn:category>
  <bpmn:category id="Category_2">
    <bpmn:categoryValue id="CatVal_2" value="2. Solicitud de cita" />
  </bpmn:category>
  <bpmn:dataStore id="DataStore_Agenda" name="Agenda centralizada" />
  <bpmn:dataStore id="DataStore_Consent" name="Consentimientos" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Comunicación con el paciente con el agente conversacional — Parte 1: acceso, consulta general y solicitud de cita" processRef="Process_1" />
    <bpmn:group id="Group_1" categoryValueRef="CatVal_1" />
    <bpmn:group id="Group_2" categoryValueRef="CatVal_2" />
    </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Paciente" name="Paciente / Familiar">
        <bpmn:flowNodeRef>Start_Msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Otro</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agente" name="Agente conversacional">
        <bpmn:flowNodeRef>GW_Aviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Aviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Acepta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoAcepta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ConvAviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Opcion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Link_Throw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Identificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Registrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Link_Throw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Horarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegCita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_CitaBot</bpmn:flowNodeRef>
        </bpmn:lane>
      <bpmn:lane id="Lane_Secretaria" name="Secretaria">
        <bpmn:flowNodeRef>GW_Canal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SecAgenda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Sec</bpmn:flowNodeRef>
        </bpmn:lane>
      <bpmn:lane id="Lane_Odonto" name="Odontólogo/a">
        <bpmn:flowNodeRef>Task_OdoAgenda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Odo</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>

    
    <bpmn:startEvent id="Start_Msg" name="Escribe al WhatsApp del centro">
      <bpmn:messageEventDefinition id="MED_1" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_Aviso" name="¿Aviso aceptado?" />
    <bpmn:serviceTask id="Task_Aviso" name="Presentar aviso de privacidad y registrar la respuesta">
      <bpmn:dataOutputAssociation id="DOA_Consent"><bpmn:targetRef>DSRef_Consent</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Acepta" name="¿Acepta?" />
    <bpmn:endEvent id="End_NoAcepta" name="Sin tratamiento de datos" />
    <bpmn:exclusiveGateway id="GW_ConvAviso" />
    <bpmn:serviceTask id="Task_Menu" name="Mostrar menú de opciones" />
    <bpmn:exclusiveGateway id="GW_Opcion" name="¿Opción elegida?" />
    <bpmn:endEvent id="Link_Throw1" name="Derivado a recepción (continúa en la parte 2)">
      <bpmn:messageEventDefinition id="MED_Link_Throw1" /></bpmn:endEvent>
    <bpmn:serviceTask id="Task_Info" name="Responder horarios, precios y formas de pago" />
    <bpmn:endEvent id="End_Info" name="Consulta resuelta" />

    
    <bpmn:serviceTask id="Task_Identificar" name="Identificar al paciente por su teléfono" />
    <bpmn:exclusiveGateway id="GW_Registrado" name="¿Paciente registrado?" />
    <bpmn:endEvent id="Link_Throw2" name="Derivado a recepción (continúa en la parte 2)">
      <bpmn:messageEventDefinition id="MED_Link_Throw2" /></bpmn:endEvent>
    <bpmn:serviceTask id="Task_Horarios" name="Ofrecer horarios disponibles">
      <bpmn:property id="Property_Horarios" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Horarios"><bpmn:sourceRef>DSRef_AgendaBot</bpmn:sourceRef><bpmn:targetRef>Property_Horarios</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RegCita" name="Registrar o reprogramar la cita">
      <bpmn:dataOutputAssociation id="DOA_RegCita"><bpmn:targetRef>DSRef_AgendaBot</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_CitaBot" name="Cita agendada" />

    <bpmn:startEvent id="Start_Otro" name="Solicita cita por otro canal">
      <bpmn:messageEventDefinition id="MED_2" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_Canal" name="¿Por qué canal?" />
    <bpmn:userTask id="Task_SecAgenda" name="Registrar la cita en la agenda centralizada">
      <bpmn:dataOutputAssociation id="DOA_SecAgenda"><bpmn:targetRef>DSRef_AgendaSec</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Sec" name="Cita agendada" />
    <bpmn:userTask id="Task_OdoAgenda" name="Registrar la cita en la agenda centralizada">
      <bpmn:dataOutputAssociation id="DOA_OdoAgenda"><bpmn:targetRef>DSRef_AgendaOdo</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Odo" name="Cita agendada" />

    
    <bpmn:dataStoreReference id="DSRef_Consent" name="Consentimientos" dataStoreRef="DataStore_Consent" />
    <bpmn:dataStoreReference id="DSRef_AgendaBot" name="Agenda centralizada" dataStoreRef="DataStore_Agenda" />
    <bpmn:dataStoreReference id="DSRef_AgendaSec" name="Agenda centralizada" dataStoreRef="DataStore_Agenda" />
    <bpmn:dataStoreReference id="DSRef_AgendaOdo" name="Agenda centralizada" dataStoreRef="DataStore_Agenda" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Msg" targetRef="GW_Aviso" />
    <bpmn:sequenceFlow id="F2" name="Sí" sourceRef="GW_Aviso" targetRef="GW_ConvAviso" />
    <bpmn:sequenceFlow id="F3" name="No" sourceRef="GW_Aviso" targetRef="Task_Aviso" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Aviso" targetRef="GW_Acepta" />
    <bpmn:sequenceFlow id="F5" name="Sí" sourceRef="GW_Acepta" targetRef="GW_ConvAviso" />
    <bpmn:sequenceFlow id="F6" name="No" sourceRef="GW_Acepta" targetRef="End_NoAcepta" />
    <bpmn:sequenceFlow id="F7" sourceRef="GW_ConvAviso" targetRef="Task_Menu" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Menu" targetRef="GW_Opcion" />
    <bpmn:sequenceFlow id="F9" name="Información" sourceRef="GW_Opcion" targetRef="Task_Info" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Info" targetRef="End_Info" />
    <bpmn:sequenceFlow id="F11" name="Recepción u otro" sourceRef="GW_Opcion" targetRef="Link_Throw1" />
    <bpmn:sequenceFlow id="F12" name="Agendar o reprogramar" sourceRef="GW_Opcion" targetRef="Task_Identificar" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Identificar" targetRef="GW_Registrado" />
    <bpmn:sequenceFlow id="F14" name="No" sourceRef="GW_Registrado" targetRef="Link_Throw2" />
    <bpmn:sequenceFlow id="F15" name="Sí" sourceRef="GW_Registrado" targetRef="Task_Horarios" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Horarios" targetRef="Task_RegCita" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_RegCita" targetRef="End_CitaBot" />
    <bpmn:sequenceFlow id="F18" sourceRef="Start_Otro" targetRef="GW_Canal" />
    <bpmn:sequenceFlow id="F19" name="Presencial, familiar o teléfono" sourceRef="GW_Canal" targetRef="Task_SecAgenda" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_SecAgenda" targetRef="End_Sec" />
    <bpmn:sequenceFlow id="F21" name="WhatsApp personal del profesional" sourceRef="GW_Canal" targetRef="Task_OdoAgenda" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_OdoAgenda" targetRef="End_Odo" />
    <bpmn:textAnnotation id="TA_Aviso"><bpmn:text>Solo en la primera interacción o ante una nueva versión del aviso (RF09, BN6)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Aviso" sourceRef="Task_Aviso" targetRef="TA_Aviso" />
    <bpmn:textAnnotation id="TA_Info"><bpmn:text>N1: respuesta inmediata, también fuera del horario de recepción (RF10, RNF05)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Info" sourceRef="Task_Info" targetRef="TA_Info" />
    <bpmn:textAnnotation id="TA_Agenda"><bpmn:text>N2: misma agenda y misma validación anticruce que recepción (RF07, RF11, RF12)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Agenda" sourceRef="Task_RegCita" targetRef="TA_Agenda" />
    <bpmn:textAnnotation id="TA_Canal"><bpmn:text>N4, PC7: ningún canal queda fuera de la agenda</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="A_Canal" sourceRef="End_Odo" targetRef="TA_Canal" />
    </bpmn:process>

