@startuml secuencia_recordatorio
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam ArrowColor #555555
skinparam sequence {
  LifeLineBorderColor #999999
  ParticipantBorderColor #6C8EBF
  ParticipantBackgroundColor #DAE8FC
  ActorBorderColor #D79B00
  ActorBackgroundColor #FFE6CC
  GroupBorderColor #999999
}
autonumber
hide footbox

participant "API del\nsistema" as API
participant "Agente" as A #D5E8D4
participant "WhatsApp" as W #F5F5F5
actor "Paciente" as P

A -> API : recordatorios pendientes
API --> A : citas de mañana
A -> W : plantilla del día anterior
W -> P : Confirmar / Cancelar / Reprogramar
A -> API : enviado
P -> W : pulsa un botón
W -> A : webhook
A -> API : respuesta del paciente
alt Confirmar
  API --> A : cita confirmada
else Cancelar
  API --> A : cita cancelada
else Reprogramar
  API --> A : reprogramación solicitada
  A -> P : nuevos horarios
end
A -> P : respuesta
note over A, P : Solo pacientes con aviso aceptado.\nCancelar o reprogramar hasta 2 h antes.
@enduml
