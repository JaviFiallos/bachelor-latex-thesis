@startuml estados_conversacion
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam state {
  RoundCorner 12
  BackgroundColor #D5E8D4
  BorderColor #82B366
  BackgroundColor<<derivar>> #FFE6CC
  BorderColor<<derivar>> #D79B00
  BackgroundColor<<recordatorio>> #DAE8FC
  BorderColor<<recordatorio>> #6C8EBF
  BackgroundColor<<interprete>> #F5F5F5
  BorderColor<<interprete>> #666666
}
hide empty description
hide stereotype

state "Aviso de privacidad" as Aviso
state "Intérprete" as Interprete <<interprete>>
state "Menú" as Menu
state "Identificación" as Identificacion
state "Agendar o reprogramar" as Cita
state "Recordatorio" as Recordatorio <<recordatorio>>
state "Derivación" as Derivar <<derivar>>

[*] --> Aviso : primer mensaje
Aviso --> Menu : acepta
[*] --> Interprete : texto libre
Interprete --> Menu : información o\nno reconocido
Interprete --> Identificacion : agendar o\nreprogramar
Interprete --> Derivar : clínica o\nrecepción
Menu --> Identificacion : agendar o\nreprogramar
Menu --> Derivar : recepción
Identificacion --> Cita
Identificacion --> Derivar : sin coincidencia
Cita --> [*] : confirma
[*] --> Recordatorio : día anterior
Recordatorio --> Cita : reprogramar
Recordatorio --> [*] : confirma o cancela
Derivar --> [*]
@enduml
