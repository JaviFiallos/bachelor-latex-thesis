@startuml estados_conversacion
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam state {
  RoundCorner 12
  BackgroundColor #D5E8D4
  BorderColor #82B366
  BackgroundColor<<derivar>> #FFE6CC
  BorderColor<<derivar>> #D79B00
  BackgroundColor<<recordatorio>> #DAE8FC
  BorderColor<<recordatorio>> #6C8EBF
}
hide empty description
hide stereotype

state "Aviso de privacidad" as Aviso
state "Identificación" as Identificacion
state "Menú" as Menu
state "Información" as Informacion
state "Agendar o reprogramar" as Cita
state "Recordatorio" as Recordatorio <<recordatorio>>
state "Derivar a recepción" as Derivar <<derivar>>

[*] --> Aviso : primer mensaje
[*] --> Recordatorio : día anterior
Aviso --> Identificacion : acepta
Identificacion --> Menu
Menu --> Informacion
Menu --> Cita
Menu --> Derivar
Cita --> [*] : cita registrada
Informacion --> [*]
Derivar --> [*]
Recordatorio --> Cita : reprogramar
Recordatorio --> [*] : confirmar / cancelar
Identificacion --> Derivar : no registrado
@enduml
