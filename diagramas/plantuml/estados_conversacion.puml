@startuml estados_conversacion
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam state {
  RoundCorner 12
  BackgroundColor #D5E8D4
  BorderColor #82B366
  BackgroundColor<<derivar>> #FFE6CC
  BorderColor<<derivar>> #D79B00
  BackgroundColor<<recordatorio>> #DAE8FC
  BorderColor<<recordatorio>> #6C8EBF
}
skinparam note {
  BackgroundColor #F5F5F5
  BorderColor #999999
}
hide empty description
hide stereotype

state aceptado <<choice>>
state "Aviso de privacidad" as Aviso
state "Menú" as Menu
state "Información" as Informacion
state "Identificación" as Identificacion
state "Agendamiento" as Agendar
state "Reprogramación" as Reprogramar
state "Recordatorio" as Recordatorio <<recordatorio>>
state "Derivación a recepción" as Derivar <<derivar>>

[*] --> aceptado : mensaje del paciente
aceptado --> Menu : aviso ya aceptado
aceptado --> Aviso : primera vez
Aviso --> Menu : acepta
Aviso --> [*] : no acepta
Menu --> Informacion
Informacion --> Menu : volver
Menu --> Identificacion : agendar o\nreprogramar
Menu --> Derivar : hablar con\nrecepción
Identificacion --> Agendar
Identificacion --> Reprogramar
Identificacion --> Derivar : sin coincidencia
Agendar --> Agendar : horario ocupado
Agendar --> [*] : cita registrada
Reprogramar --> [*] : cita reprogramada
Derivar --> [*]

[*] --> Recordatorio : día anterior
Recordatorio --> [*] : confirmar\no cancelar
Recordatorio --> Reprogramar : reprogramar

note "Sin respuesta en 30 min,\nla conversación se reinicia" as N1
@enduml
