@startuml estados_conversacion
!pragma layout smetana

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam state {
  RoundCorner 8
}
hide empty description

state "Aviso de privacidad" as Aviso
state "Identificación" as Identificacion
state "Menú" as Menu
state "Información" as Informacion
state "Agendar" as Agendar
state "Reprogramar" as Reprogramar
state "Confirmación" as Confirmacion
state "Derivación a recepción" as Derivar
state "Respuesta al recordatorio" as Recordatorio
state "Fin" as Fin

[*] --> Aviso : primer mensaje
[*] --> Identificacion : aviso ya aceptado
[*] --> Recordatorio : botón del recordatorio\n(solo teléfonos con aviso aceptado)

Aviso --> Identificacion : acepta
Aviso --> Fin : no acepta

Identificacion --> Identificacion : varios pacientes:\npide la cédula
Identificacion --> Menu : paciente identificado
Identificacion --> Derivar : sin paciente o no confirma

Menu --> Informacion : horarios o precios
Menu --> Agendar : agendar
Menu --> Reprogramar : reprogramar
Menu --> Derivar : hablar con recepción

Informacion --> Menu : otra consulta

Agendar --> Confirmacion : horario elegido
Agendar --> Derivar : límite de citas alcanzado\no sin horarios disponibles

Reprogramar --> Confirmacion : horario elegido
Reprogramar --> Derivar : menos de 2 h

Confirmacion --> Agendar : conflicto en agendamiento
Confirmacion --> Reprogramar : conflicto en reprogramación
Confirmacion --> Fin : cita registrada

Recordatorio --> Fin : confirmar o cancelar
Recordatorio --> Reprogramar : reprogramar
Recordatorio --> Derivar : cancelar o reprogramar\ncon menos de 2 h

Derivar --> Fin : horario y enlace de recepción
Fin --> [*]

note as NotaTransversal
  Desde cualquier estado:
  palabra clínica, consulta de saldo
  o texto no reconocido: derivación
  30 min sin actividad: caducidad
end note
@enduml
