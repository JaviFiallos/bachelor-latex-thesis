@startuml secuencia_agendar
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam ArrowColor #555555
skinparam sequence {
  LifeLineBorderColor #999999
  ParticipantBorderColor #6C8EBF
  ParticipantBackgroundColor #DAE8FC
  ActorBorderColor #D79B00
  ActorBackgroundColor #FFE6CC
  DatabaseBorderColor #9673A6
  DatabaseBackgroundColor #E1D5E7
  GroupBorderColor #999999
}
autonumber
hide footbox

actor "Paciente" as P
participant "WhatsApp" as W #F5F5F5
participant "Agente" as A #D5E8D4
participant "Agenda" as G
database "Base de datos" as BD

P -> W : "Agendar"
W -> A : webhook
A -> G : horarios libres
G --> A : opciones
A -> P : elige día y hora
P -> A : confirma
A -> G : agendar cita
G -> BD : guardar
alt horario libre
  BD --> G : guardada
  A -> P : cita registrada
else horario ocupado
  BD --> G : conflicto
  A -> P : otros horarios
end
@enduml
