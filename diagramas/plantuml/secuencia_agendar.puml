@startuml secuencia_agendar
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
skinparam ArrowColor #555555
skinparam sequence {
  LifeLineBorderColor #999999
  ParticipantBorderColor #6C8EBF
  ParticipantBackgroundColor #DAE8FC
  ActorBorderColor #D79B00
  ActorBackgroundColor #FFE6CC
  DatabaseBorderColor #9673A6
  DatabaseBackgroundColor #E1D5E7
  GroupBorderColor #999999
}
autonumber
hide footbox

actor "Paciente" as P
participant "WhatsApp" as W #F5F5F5
participant "Agente" as A #D5E8D4
participant "Modelo de\nlenguaje" as L #F5F5F5
participant "API del\nsistema" as API
database "Base de\ndatos" as BD

P -> W : "Quiero una limpieza el martes"
W -> A : webhook
A -> L : texto y paso actual
L --> A : intención y datos\n(agendar, especialidad, día)
A -> API : identificar por teléfono
API --> A : paciente
A -> API : horarios libres
API --> A : opciones
A -> P : lista de horas
P -> A : elige hora
A -> P : resumen y botón Confirmar
P -> A : Confirmar
A -> API : registrar cita
API -> BD : guardar
alt horario libre
  BD --> API : guardada
  API --> A : cita
  A -> P : cita registrada
else horario ocupado
  BD --> API : conflicto
  API --> A : horario ocupado
  A -> P : otros horarios
end
note over A, L : El modelo solo interpreta; no recibe nombre,\ncédula ni historial, y no registra citas.
@enduml
