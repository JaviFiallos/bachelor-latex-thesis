@startuml secuencia_agendar

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
autonumber

actor "Paciente" as Paciente
participant "WhatsApp Cloud API\n(Meta)" as Meta
participant "Webhook" as Webhook
participant "Motor conversacional" as Motor
participant "ProfessionalDirectory" as Profesionales
participant "AppointmentScheduler" as Agenda
database "Base de datos" as BD

note over Paciente, Motor
  Aviso aceptado y paciente identificado
  antes del menú (estado en memoria)
end note

Paciente -> Meta : elige "Agendar" del menú
Meta -> Webhook : evento firmado
Webhook -> Webhook : valida la firma
Webhook -> Motor : mensaje entrante
Motor -> Agenda : consulta citas activas (límites)
Agenda --> Motor : límites no alcanzados
Motor -> Profesionales : especialidades, profesionales y horarios
Profesionales --> Motor : opciones de los próximos 14 días
Motor -> Meta : listas de especialidad, profesional, día y hora
Meta -> Paciente : opciones
Paciente -> Meta : elige profesional, día y hora
Meta -> Webhook : evento firmado
Webhook -> Motor : selección
Motor -> Meta : resumen de la cita con botón Confirmar
Meta -> Paciente : resumen
Paciente -> Meta : confirma
Meta -> Webhook : evento firmado
Webhook -> Motor : confirmación
Motor -> Agenda : agendar cita (origen agente)
Agenda -> BD : registrar cita pendiente
alt horario ocupado (restricción de exclusión)
  BD --> Agenda : conflicto
  Agenda --> Motor : horario no disponible
  Motor -> Meta : informa y ofrece otros horarios
  Meta -> Paciente : nuevas opciones
else horario libre
  BD --> Agenda : cita guardada
  Agenda --> Motor : cita creada
  Motor -> Meta : confirma fecha, hora y profesional
  Meta -> Paciente : cita registrada
end
@enduml
